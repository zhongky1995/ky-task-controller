      {"id": "diagnose", "title": "Revision diagnosis", "kind": "analysis", "purpose": "Diagnose changes while preserving the source map.", "capabilityRequirements": ["document-revision"], "acceptanceIds": [], "outputContracts": [{"id": "revision-plan"}]},
      {"id": "revise", "title": "Controlled revision", "kind": "implementation", "purpose": "Apply the controlled document revision.", "dependsOn": ["diagnose"], "capabilityRequirements": ["document-revision"], "acceptanceIds": [], "writeBoundary": "approved-target", "writeTargets": "$approvedTargets", "inputContracts": [{"id": "revision-plan"}], "outputContracts": [{"id": "revised-document"}]},
