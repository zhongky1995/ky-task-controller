{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solution-graph.schema.json",
  "title": "SolutionGraph v1",
  "type": "object",
  "required": ["graphVersion", "id", "blueprintDigest", "scenarioPack", "routingDigest", "nodes", "edges", "topologicalOrder", "graphDigest"],
  "properties": {
    "graphVersion": {"type": "string"},
    "id": {"type": "string"},
    "blueprintDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scenarioPack": {
      "type": "object",
      "required": ["id", "version", "fingerprint"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "fingerprint": {"type": "string"}},
      "additionalProperties": false
    },
    "routingDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "topologicalOrder": {"type": "array", "items": {"type": "string"}},
    "graphExecutable": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "object"}},
    "graphDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "edge": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}, "additionalProperties": false},
    "binding": {"type": "object", "required": ["capabilityId", "role"], "properties": {"capabilityId": {"type": "string"}, "role": {"type": "string"}}, "additionalProperties": false},
    "node": {
      "type": "object",
      "required": ["id", "title", "kind", "purpose", "dependsOn", "inputContracts", "outputContracts", "capabilityRequirements", "capabilityBindings", "unitIds", "sourceIds", "decisionIds", "acceptanceIds", "writeBoundary", "writeTargets", "workerRequired", "userApprovalRequired"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"}, "kind": {"type": "string"}, "purpose": {"type": "string"},
        "dependsOn": {"type": "array", "items": {"type": "string"}}, "inputContracts": {"type": "array"}, "outputContracts": {"type": "array"},
        "capabilityRequirements": {"type": "array", "items": {"type": "string"}}, "capabilityBindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
        "unitIds": {"type": "array", "items": {"type": "string"}}, "sourceIds": {"type": "array", "items": {"type": "string"}},
        "decisionIds": {"type": "array", "items": {"type": "string"}}, "acceptanceIds": {"type": "array", "items": {"type": "string"}},
        "writeBoundary": {"enum": ["none", "approved-target", "review-only"]}, "writeTargets": {"type": "array"},
        "workerRequired": {"type": "boolean"}, "userApprovalRequired": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
