{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task-controller.local/contracts/operation-permit.schema.json",
  "title": "OperationPermit v1",
  "type": "object",
  "required": [
    "permitVersion", "permitId", "planIdentity", "graphIdentity", "packetIdentity",
    "blueprintIdentity", "contractIdentity", "workerId", "runtimeHandle", "capabilityId",
    "operationId", "targetId", "targetLocator", "action", "payload", "payloadFingerprint",
    "restrictedFields", "approvalRefs", "idempotencyKey", "adapterId", "readbackSpec",
    "issuedAt", "expiresAt", "status"
  ],
  "properties": {
    "permitVersion": {"const": "1.0"},
    "permitId": {"type": "string", "minLength": 1},
    "planIdentity": {"$ref": "#/$defs/identity"},
    "graphIdentity": {"$ref": "#/$defs/identity"},
    "packetIdentity": {"$ref": "#/$defs/identity"},
    "blueprintIdentity": {"$ref": "#/$defs/identity"},
    "contractIdentity": {"$ref": "#/$defs/identity"},
    "workerId": {"type": "string", "minLength": 1},
    "runtimeHandle": {"type": "string", "minLength": 1},
    "capabilityId": {"type": "string", "minLength": 1},
    "operationId": {"type": "string", "minLength": 1},
    "targetId": {"type": "string", "minLength": 1},
    "targetLocator": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "payload": {},
    "payloadFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "restrictedFields": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "approvalRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "idempotencyKey": {"type": "string", "minLength": 1},
    "adapterId": {"type": "string", "minLength": 1},
    "readbackSpec": {"type": "object"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["issued", "claimed", "consumed", "revoked", "expired", "reconcile_required"]},
    "claimId": {"type": "string", "minLength": 1},
    "claimedAt": {"type": "string", "format": "date-time"},
    "consumedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
